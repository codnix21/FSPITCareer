generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum Grade {
  INTERN
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum ProfileStatus {
  DRAFT
  ASSESSMENT_REQUIRED
  AVAILABLE
  HIDDEN
}

enum WorkFormat {
  REMOTE
  OFFICE
  HYBRID
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FspAchievementSource {
  FSP
  DEMO
}

enum FspLinkStatus {
  CONNECTED
  NOT_FOUND
  UNAVAILABLE
}

enum VacancyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ResumeStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum AssessmentResultStatus {
  PASSED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  firstName     String
  lastName      String
  phone         String?
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidateProfile         CandidateProfile?
  company                  Company?
  offersSent               Offer[]                 @relation("EmployerOffers")
  offersReceived           Offer[]                 @relation("CandidateOffers")
  privacySettings          PrivacySettings?
  auditLogs                AuditLog[]              @relation("AuditActor")
  emailVerificationTokens  EmailVerificationToken[]

  @@index([role])
  @@index([email])
  @@index([emailVerified])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Industry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specializations Specialization[]
  candidates      CandidateProfile[]
  vacancies       Vacancy[]
  assessments     Assessment[]

  @@index([isActive])
}

model Specialization {
  id          String   @id @default(cuid())
  industryId  String
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  industry   Industry            @relation(fields: [industryId], references: [id], onDelete: Cascade)
  categories  CandidateCategory[]
  candidates  CandidateProfile[]
  vacancies   Vacancy[]
  assessments Assessment[]
  challenges  Challenge[]

  @@index([industryId])
  @@index([isActive])
}

model CandidateCategory {
  id               String   @id @default(cuid())
  specializationId String
  grade            Grade
  slug             String   @unique
  name             String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  specialization Specialization     @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  candidates     CandidateProfile[]

  @@unique([specializationId, grade])
  @@index([grade])
  @@index([isActive])
}

model PrivacySettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  profileVisibility  String   @default("EMPLOYERS")
  contactVisibility  String   @default("AFTER_ACCEPT")
  consentVersion     String
  consentAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  description String?
  website     String?
  city        String?
  onboardingCompleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies Vacancy[]
  offers    Offer[]
}

model CandidateProfile {
  id                   String        @id @default(cuid())
  userId               String        @unique
  roleTitle            String
  grade                Grade
  experienceYears      Float         @default(0)
  salaryFrom           Int?
  salaryTo             Int?
  workFormat           WorkFormat    @default(REMOTE)
  about                String?
  city                 String?
  isVerified           Boolean       @default(false)
  onboardingCompleted  Boolean       @default(false)
  profileStatus        ProfileStatus @default(DRAFT)
  industryId           String?
  specializationId     String?
  candidateCategoryId  String?
  /// Self-declared grade remains in `grade`; assessment outcome stored here
  recommendedGrade     Grade?
  fspParticipantId     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry         Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  specialization   Specialization?    @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  candidateCategory CandidateCategory? @relation(fields: [candidateCategoryId], references: [id], onDelete: SetNull)
  skills           CandidateSkill[]
  experiences      Experience[]
  educations       Education[]
  resumes          Resume[]
  matches          Match[]
  testAttempts     TestAttempt[]
  achievements     FspAchievement[]
  assessmentAttempts AssessmentAttempt[]
  assessmentResults  AssessmentResult[]
  applications       Application[]
  challengeAttempts  ChallengeAttempt[]

  @@index([roleTitle])
  @@index([grade])
  @@index([recommendedGrade])
  @@index([workFormat])
  @@index([fspParticipantId])
  @@index([profileStatus])
  @@index([industryId])
  @@index([specializationId])
  @@index([candidateCategoryId])
}

model Skill {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String?  @unique
  category       String?
  aliases        String[] @default([])
  externalSource String?
  externalId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidates CandidateSkill[]
  vacancies  VacancySkill[]
  challenges Challenge[]

  @@unique([externalSource, externalId])
  @@index([isActive])
  @@index([category])
}

model City {
  id             String   @id @default(cuid())
  name           String
  region         String?
  country        String   @default("Россия")
  aliases        String[] @default([])
  externalSource String?
  externalId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, country])
  @@unique([externalSource, externalId])
  @@index([isActive])
  @@index([name])
}

model CandidateSkill {
  id          String @id @default(cuid())
  candidateId String
  skillId     String
  level       Int    @default(3)

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([skillId])
}

model Experience {
  id          String    @id @default(cuid())
  candidateId String
  company     String
  position    String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Education {
  id          String  @id @default(cuid())
  candidateId String
  institution String
  degree      String?
  field       String?
  yearFrom    Int?
  yearTo      Int?

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Vacancy {
  id               String        @id @default(cuid())
  companyId        String
  title            String
  roleTitle        String
  grade            Grade
  experienceFrom   Float         @default(0)
  experienceTo     Float?
  salaryFrom       Int?
  salaryTo         Int?
  workFormat       WorkFormat    @default(REMOTE)
  description      String?
  requirements     String?
  status           VacancyStatus @default(ACTIVE)
  industryId       String?
  specializationId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry       Industry?       @relation(fields: [industryId], references: [id], onDelete: SetNull)
  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  skills         VacancySkill[]
  matches        Match[]
  offers         Offer[]
  applications   Application[]

  @@index([status])
  @@index([roleTitle])
  @@index([grade])
  @@index([companyId])
  @@index([industryId])
  @@index([specializationId])
}

/// Candidate self-apply to vacancy (Wave D.1). Active uniqueness enforced via partial index in migration.
model Application {
  id           String            @id @default(cuid())
  candidateId  String
  vacancyId    String
  status       ApplicationStatus @default(SUBMITTED)
  coverLetter  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  withdrawnAt  DateTime?
  reviewedAt   DateTime?

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy   Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([vacancyId])
  @@index([status])
  @@index([createdAt])
  @@index([candidateId, vacancyId])
}

model VacancySkill {
  id        String @id @default(cuid())
  vacancyId String
  skillId   String
  isRequired Boolean @default(true)

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, skillId])
  @@index([skillId])
}

model FspParticipant {
  id        String   @id @default(cuid())
  externalId String  @unique
  name      String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())

  disciplines FspParticipantDiscipline[]
  results     FspResult[]
  roles       String[]
  ranks       String[]
}

model FspDiscipline {
  id   String @id @default(cuid())
  code String @unique
  name String

  participants FspParticipantDiscipline[]
  competitions FspCompetition[]
}

model FspParticipantDiscipline {
  id            String @id @default(cuid())
  participantId String
  disciplineId  String

  participant FspParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  discipline  FspDiscipline  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([participantId, disciplineId])
}

model FspCompetition {
  id           String @id @default(cuid())
  name         String
  year         Int
  disciplineId String?

  discipline FspDiscipline? @relation(fields: [disciplineId], references: [id])
  results    FspResult[]
}

model FspResult {
  id            String @id @default(cuid())
  participantId String
  competitionId String
  place         Int?
  status        String

  participant FspParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  competition FspCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model FspAchievement {
  id          String               @id @default(cuid())
  candidateId String
  title       String
  discipline  String
  place       Int?
  year        Int
  status      String
  isDemo      Boolean              @default(true)
  source      FspAchievementSource @default(DEMO)
  createdAt   DateTime             @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([source])
}

model Resume {
  id          String       @id @default(cuid())
  candidateId String
  fileName    String
  filePath    String
  mimeType    String
  status      ResumeStatus @default(UPLOADED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  analysis  ResumeAnalysis?

  @@index([candidateId])
}

model ResumeAnalysis {
  id          String   @id @default(cuid())
  resumeId    String   @unique
  roleTitle   String?
  experienceYears Float?
  skills      String[]
  rawJson     Json?
  createdAt   DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Match {
  id          String   @id @default(cuid())
  candidateId String
  vacancyId   String
  score       Float
  breakdown   Json
  reasons     String[]
  createdAt   DateTime @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy   Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([candidateId, vacancyId])
  @@index([score])
}

model Offer {
  id          String      @id @default(cuid())
  vacancyId   String
  companyId   String
  employerId  String
  candidateId String
  /// Snapshot at send time (do not re-read from Vacancy for historical display)
  title       String?
  description String?
  /// Legacy single salary; mirrored from salaryFrom when set
  salary      Int?
  salaryFrom  Int?
  salaryTo    Int?
  currency    String      @default("RUB")
  workFormat  WorkFormat?
  message     String?
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employer  User    @relation("EmployerOffers", fields: [employerId], references: [id], onDelete: Cascade)
  candidate User    @relation("CandidateOffers", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([candidateId])
  @@index([employerId])
  @@index([expiresAt])
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  questions TestQuestion[]
  attempts  TestAttempt[]
}

model TestQuestion {
  id       String @id @default(cuid())
  testId   String
  question String
  options  String[]
  answer   Int

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model TestAttempt {
  id          String   @id @default(cuid())
  testId      String
  candidateId String
  score       Float
  maxScore    Float
  completedAt DateTime @default(now())

  test      Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

/// Production assessment engine (Wave C). Legacy Test* kept for backward compatibility.
model Assessment {
  id               String           @id @default(cuid())
  name             String
  description      String?
  industryId       String
  specializationId String
  version          Int              @default(1)
  status           AssessmentStatus @default(DRAFT)
  timeLimitSeconds Int              @default(1800)
  passingScore     Float            @default(50)
  cooldownHours    Int              @default(72)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  industry       Industry                    @relation(fields: [industryId], references: [id], onDelete: Cascade)
  specialization Specialization               @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  blueprints     AssessmentBlueprint[]
  questions      AssessmentQuestion[]
  thresholds     AssessmentGradeThreshold[]
  attempts       AssessmentAttempt[]
  results        AssessmentResult[]

  @@index([status])
  @@index([specializationId])
  @@index([industryId])
  @@unique([specializationId, version])
}

model AssessmentBlueprint {
  id           String   @id @default(cuid())
  assessmentId String
  name         String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sections   AssessmentBlueprintSection[]

  @@index([assessmentId])
}

model AssessmentBlueprintSection {
  id            String              @id @default(cuid())
  blueprintId   String
  skill         String
  weight        Float
  questionCount Int
  difficulty    QuestionDifficulty?
  required      Boolean             @default(true)

  blueprint AssessmentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
  @@index([skill])
}

model AssessmentQuestion {
  id                   String             @id @default(cuid())
  assessmentId         String
  skill                String
  difficulty           QuestionDifficulty @default(MEDIUM)
  type                 QuestionType       @default(SINGLE_CHOICE)
  text                 String
  options              String[]
  correctOptionIndexes Int[]
  explanation          String?
  points               Float              @default(1)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  assessment Assessment                    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
  attemptQs  AssessmentAttemptQuestion[]

  @@index([assessmentId])
  @@index([skill])
  @@index([difficulty])
  @@index([isActive])
}

model AssessmentGradeThreshold {
  id           String @id @default(cuid())
  assessmentId String
  grade        Grade
  minScore     Float
  maxScore     Float

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, grade])
  @@index([assessmentId])
}

model AssessmentAttempt {
  id                String        @id @default(cuid())
  candidateId       String
  assessmentId      String
  assessmentVersion Int
  startedAt         DateTime      @default(now())
  expiresAt         DateTime
  submittedAt       DateTime?
  status            AttemptStatus @default(IN_PROGRESS)
  score             Float?
  correctAnswers    Int?
  totalQuestions    Int           @default(0)
  recommendedGrade  Grade?
  selfDeclaredGrade Grade?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  candidate  CandidateProfile             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentAttemptQuestion[]
  answers    AssessmentAnswer[]
  result     AssessmentResult?

  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
  @@index([expiresAt])
}

model AssessmentAttemptQuestion {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  position   Int

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AssessmentAnswer {
  id                    String   @id @default(cuid())
  attemptId             String
  questionId            String
  selectedOptionIndexes Int[]
  isCorrect             Boolean?
  answeredAt            DateTime @default(now())

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AssessmentResult {
  id                  String                  @id @default(cuid())
  attemptId           String                  @unique
  candidateId         String
  assessmentId        String
  assessmentVersion   Int
  score               Float
  status              AssessmentResultStatus
  recommendedGrade    Grade
  selfDeclaredGrade   Grade?
  candidateCategoryId String?
  sectionScores       Json
  createdAt           DateTime                @default(now())

  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  candidate  CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([assessmentId])
  @@index([status])
}

/// Regular challenges (Wave D.2) — separate from Assessment Engine categorization.
model Challenge {
  id               String             @id @default(cuid())
  title            String
  description      String?
  specializationId String?
  skillId          String?
  difficulty       QuestionDifficulty @default(MEDIUM)
  status           ChallengeStatus    @default(DRAFT)
  timeLimitSeconds Int?
  maxAttempts      Int                @default(1)
  passingScore     Float              @default(70)
  publishedAt      DateTime?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  specialization Specialization?     @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  skill          Skill?              @relation(fields: [skillId], references: [id], onDelete: SetNull)
  questions      ChallengeQuestion[]
  attempts       ChallengeAttempt[]

  @@index([status])
  @@index([specializationId])
  @@index([skillId])
  @@index([publishedAt])
  @@index([difficulty])
}

model ChallengeQuestion {
  id                   String       @id @default(cuid())
  challengeId          String
  type                 QuestionType @default(SINGLE_CHOICE)
  prompt               String
  options              String[]
  correctOptionIndexes Int[]
  points               Float        @default(1)
  sortOrder            Int          @default(0)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  challenge Challenge                     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  answers   ChallengeAnswer[]
  attemptQs ChallengeAttemptQuestion[]

  @@index([challengeId])
  @@index([sortOrder])
}

model ChallengeAttempt {
  id            String        @id @default(cuid())
  challengeId   String
  candidateId   String
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  expiresAt     DateTime?
  score         Float?
  passed        Boolean?
  attemptNumber Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  challenge Challenge                   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  candidate CandidateProfile            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questions ChallengeAttemptQuestion[]
  answers   ChallengeAnswer[]

  @@index([candidateId])
  @@index([challengeId])
  @@index([status])
  @@index([expiresAt])
  @@index([candidateId, challengeId])
}

model ChallengeAttemptQuestion {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  position   Int

  attempt  ChallengeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ChallengeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model ChallengeAnswer {
  id                    String   @id @default(cuid())
  attemptId             String
  questionId            String
  selectedOptionIndexes Int[]
  isCorrect             Boolean?
  answeredAt            DateTime @default(now())

  attempt  ChallengeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ChallengeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
