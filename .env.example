# Database
POSTGRES_USER=fsp
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=fsp_career
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fsp:replace_with_strong_db_password@postgres:5432/fsp_career?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# JWT — минимум 32 символа, без demo/change_me
JWT_SECRET=replace_with_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost
NODE_ENV=production
SWAGGER_ENABLED=false
SEED_ON_START=false
PRIVACY_POLICY_VERSION=2026-10-01
EMAIL_PROVIDER=console
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_APP_URL=http://localhost:3000
OFFER_TTL_DAYS=14
FSP_PROVIDER=local
# FSP_EXTERNAL_URL=
# FSP_EXTERNAL_TIMEOUT_MS=3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_VERIFICATION_RETURN_TOKEN=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000
NGINX_PORT=80

# ML Service
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

HH_API_BASE_URL=https://api.hh.ru
HH_USER_AGENT=FSP IT Career/1.0 (contact@fsp-career.ru)
HH_CACHE_TTL_SEC=600
