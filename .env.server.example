# === FSP IT Career — сервер itcareer.netcorehub.ru ===
# Скопировать: cp .env.server.example .env
# Затем: docker compose up -d --build

POSTGRES_USER=fsp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fsp_career
DATABASE_URL=postgresql://fsp:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/fsp_career?schema=public

REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Порт процесса внутри контейнера backend (не менять)
API_PORT=3001
API_HOST=0.0.0.0

# Публикация на хост (localhost + свободные порты — не трогаем grafana:3000 / library:3001 / myadminservers:8899)
POSTGRES_PUBLISH=127.0.0.1:5436
REDIS_PUBLISH=127.0.0.1:6386
ML_SERVICE_PUBLISH=127.0.0.1:8006
API_PUBLISH=127.0.0.1:3021
WEB_PUBLISH=127.0.0.1:3020
NGINX_PUBLISH=127.0.0.1:8920

CORS_ORIGIN=https://itcareer.netcorehub.ru,https://www.itcareer.netcorehub.ru,http://itcareer.netcorehub.ru
NODE_ENV=production
SWAGGER_ENABLED=false
SEED_ON_START=true
PRIVACY_POLICY_VERSION=2026-10-01
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=support@cabinet.netcorehub.ru
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_APP_URL=https://itcareer.netcorehub.ru
OFFER_TTL_DAYS=14
FSP_PROVIDER=local

# URL API для браузера (через домен → FastPanel → docker nginx → /api)
NEXT_PUBLIC_API_URL=https://itcareer.netcorehub.ru/api
NEXT_PUBLIC_APP_URL=https://itcareer.netcorehub.ru

ML_SERVICE_URL=http://ml-service:8000
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

HH_API_BASE_URL=https://api.hh.ru
HH_USER_AGENT=FSP IT Career/1.0 (contact@fsp-career.ru)
HH_CACHE_TTL_SEC=600
